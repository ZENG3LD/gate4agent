# Build output. The pattern is `target*/` rather than `target/` as a safety
# net for scenario-scoped directories that already exist -- NOT as licence
# to create them: one target per workspace, see CLAUDE.md's own "Build
# output" section for why. Matches `is_skipped_workspace_directory`'s
# CACHEDIR.TAG-based node-side walk skip
# (crates/gate4agent-node/src/server.rs) in intent, not just by name.
target*/
Cargo.lock
!crates/gate4agent-tui/Cargo.lock

# Local planning and research — not part of the crate release
/docs/plans/
/docs/research/

# Live-stack run directories (logs, per-run sqlite, tokens, screenshots)
/.run/

# gate4agent-tui's icon bake tool's own downloaded-SVG scratch cache --
# reproducible from tools/bake_icons.py against upstream codicons, not a
# source of truth (the checked-in src/icons/*.rgba baked assets are).
crates/gate4agent-tui/tools/.codicon-cache/
# Same, for the upstream Lucide source SVGs (alongside codicons -- see
# `app::IconFamily`'s own doc comment).
crates/gate4agent-tui/tools/.lucide-cache/

# Python bytecode from the icon-baking tool
__pycache__/
*.pyc
